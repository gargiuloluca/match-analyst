<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AtmBetSignal — Storico & Performance</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #07090e;
      --card-bg: #0f141f;
      --card-border: #1a2233;
      --text-main: #f8fafc;
      --text-muted: #8b9bb4;
      --atm-green: #22c55e;
      --atm-green-glow: rgba(34, 197, 94, 0.25);
      --red-lost: #ef4444;
      --pending: #f59e0b;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      line-height: 1.5;
      padding: 24px 16px;
      min-height: 100vh;
      background-image: radial-gradient(circle at 50% 0%, rgba(34, 197, 94, 0.08), transparent 45%);
    }

    .container { max-width: 1040px; margin: 0 auto; }

    header {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--card-border);
    }

    .brand-logo-wrap {
      width: 64px;
      height: 64px;
      flex-shrink: 0;
      background: radial-gradient(circle, rgba(34, 197, 94, 0.15) 0%, rgba(15, 20, 31, 1) 100%);
      border-radius: 12px;
      border: 1.5px solid var(--atm-green);
      box-shadow: 0 0 12px var(--atm-green-glow);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 4px;
    }

    .brand-logo-wrap img { width: 100%; height: 100%; object-fit: contain; }

    .brand-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      letter-spacing: 0.18em;
      color: var(--atm-green);
      font-weight: 700;
      text-transform: uppercase;
    }

    h1 { font-size: 1.5rem; font-weight: 800; margin-bottom: 4px; }
    .subtitle { color: var(--text-muted); font-size: 0.82rem; }

    .nav-links { display: flex; gap: 16px; margin-top: 10px; }
    .nav-link { font-size: 0.82rem; text-decoration: none; color: var(--text-muted); font-weight: 600; }
    .nav-link.active { color: var(--atm-green); border-bottom: 2px solid var(--atm-green); padding-bottom: 4px; }

    /* STATS KPI */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 28px;
    }

    .kpi-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 10px;
      padding: 16px;
    }

    .kpi-label {
      font-size: 0.7rem;
      font-family: 'JetBrains Mono', monospace;
      text-transform: uppercase;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }

    .kpi-val {
      font-size: 1.6rem;
      font-weight: 800;
      font-family: 'JetBrains Mono', monospace;
    }

    .kpi-sub { font-size: 0.7rem; color: var(--text-muted); margin-top: 4px; }

    /* TABELLA STORICO */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--card-border);
      border-radius: 10px;
      background: var(--card-bg);
    }

    table { width: 100%; border-collapse: collapse; font-size: 0.82rem; text-align: left; }
    th {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      color: var(--text-muted);
      padding: 12px 14px;
      border-bottom: 1px solid var(--card-border);
    }
    td { padding: 12px 14px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); }

    .status-badge {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    .badge-won { background: rgba(34, 197, 94, 0.15); color: var(--atm-green); border: 1px solid var(--atm-green); }
    .badge-lost { background: rgba(239, 68, 68, 0.15); color: var(--red-lost); border: 1px solid var(--red-lost); }
    .badge-pending { background: rgba(245, 158, 11, 0.15); color: var(--pending); border: 1px solid var(--pending); }

    .mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="brand-logo-wrap">
        <img src="assets/logo.png" alt="AtmBet Logo" onerror="this.style.display='none'">
      </div>
      <div>
        <div class="brand-tag">ATMBET SIGNAL</div>
        <h1>Performance & Storico Giocate</h1>
        <p class="subtitle">Tracciamento trasparente degli esiti reali, calcolo automatico del Win-Rate e del ROI cumulato.</p>
        <div class="nav-links">
          <a href="index.html" class="nav-link">Oggi</a>
          <a href="tracker.html" class="nav-link active">Storico & ROI</a>
        </div>
      </div>
    </header>

    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">Win Rate Reale</div>
        <div class="kpi-val" id="kpi-winrate" style="color: var(--atm-green);">0.0%</div>
        <div class="kpi-sub" id="kpi-counts">0 vinte / 0 perse</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">ROI Netto</div>
        <div class="kpi-val" id="kpi-roi">0.0%</div>
        <div class="kpi-sub">Rendimento sul volume</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Profitto Cumulato</div>
        <div class="kpi-val" id="kpi-profit">+0.00 u</div>
        <div class="kpi-sub">Stake costante 1 unità</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Giocate Totali</div>
        <div class="kpi-val" id="kpi-total">0</div>
        <div class="kpi-sub">Segnali certificati</div>
      </div>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Data</th>
            <th>Match</th>
            <th>Pronostico</th>
            <th>Quota</th>
            <th>Risultato</th>
            <th>Stato</th>
            <th>Profitto</th>
          </tr>
        </thead>
        <tbody id="tracker-body">
          <tr>
            <td colspan="7" style="text-align:center; padding: 24px; color: var(--text-muted);">Caricamento storico scommesse...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    async function loadTracker() {
      try {
        const res = await fetch(`data/tracker.json?t=${new Date().getTime()}`);
        if (!res.ok) throw new Error("File tracker.json non trovato");
        const data = await res.json();

        document.getElementById('kpi-winrate').textContent = `${data.win_rate || 0.0}%`;
        document.getElementById('kpi-counts').textContent = `${data.won || 0} vinte / ${data.lost || 0} perse`;
        
        const roi = data.roi_pct || 0.0;
        const roiElem = document.getElementById('kpi-roi');
        roiElem.textContent = `${roi >= 0 ? '+' : ''}${roi}%`;
        roiElem.style.color = roi >= 0 ? 'var(--atm-green)' : 'var(--red-lost)';

        const profit = data.net_profit_units || 0.0;
        const profElem = document.getElementById('kpi-profit');
        profElem.textContent = `${profit >= 0 ? '+' : ''}${profit.toFixed(2)} u`;
        profElem.style.color = profit >= 0 ? 'var(--atm-green)' : 'var(--red-lost)';

        document.getElementById('kpi-total').textContent = data.total_bets || 0;

        const tbody = document.getElementById('tracker-body');
        tbody.innerHTML = '';

        const bets = (data.bets || []).slice().reverse(); // Più recenti in alto
        if (bets.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding: 20px; color: var(--text-muted);">Nessuna scommessa registrata nello storico.</td></tr>`;
          return;
        }

        bets.forEach(b => {
          const tr = document.createElement('tr');
          const isWon = b.status === 'WON';
          const isLost = b.status === 'LOST';
          const badgeClass = isWon ? 'badge-won' : (isLost ? 'badge-lost' : 'badge-pending');
          const statusText = isWon ? 'VINTA' : (isLost ? 'PERSA' : 'IN CORSO');

          const prof = b.profit !== undefined ? b.profit : 0;
          const profSign = prof > 0 ? `+${prof.toFixed(2)}` : prof.toFixed(2);
          const profColor = isWon ? 'var(--atm-green)' : (isLost ? 'var(--red-lost)' : 'var(--text-muted)');

          tr.innerHTML = `
            <td class="mono" style="font-size:0.75rem; color:var(--text-muted);">${b.date || '-'}</td>
            <td><strong>${b.match}</strong><div style="font-size:0.7rem; color:var(--text-muted);">${b.league || ''}</div></td>
            <td>${b.outcome_label}</td>
            <td class="mono">${(b.odd || 0).toFixed(2)}</td>
            <td class="mono">${b.score || '-'}</td>
            <td><span class="status-badge ${badgeClass}">${statusText}</span></td>
            <td class="mono" style="color: ${profColor}; font-weight:700;">${b.status === 'PENDING' ? '-' : profSign + ' u'}</td>
          `;
          tbody.appendChild(tr);
        });

      } catch (err) {
        console.error(err);
        document.getElementById('tracker-body').innerHTML = 
          `<tr><td colspan="7" style="text-align:center; color: #ef4444; padding: 20px;">Impossibile caricare il tracker: ${err.message}</td></tr>`;
      }
    }

    loadTracker();
  </script>
</body>
</html>
